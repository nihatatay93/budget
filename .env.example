# Application
BUDGET_ENV=development
BUDGET_HTTP_ADDR=:8080
# Host port the application is published on. Change it if 8080 is already in use.
BUDGET_HTTP_PORT=8080
BUDGET_PUBLIC_ORIGIN=http://localhost:8080
BUDGET_SESSION_COOKIE_SECURE=false
BUDGET_SESSION_TTL=720h

# Request throttling and proxy trust
# Credential endpoints (login, register, invitation acceptance) are throttled per client.
# Ordinary reads are never throttled. Set BUDGET_AUTH_RATE_LIMIT=0 to disable.
BUDGET_AUTH_RATE_LIMIT=20
BUDGET_AUTH_RATE_BURST=10
#
# Behind a reverse proxy the peer address is the proxy, so the client is identified from
# X-Forwarded-For only when the peer is listed here. Leave empty for a direct deployment:
# believing the header from an untrusted peer lets any caller reset their own limit by
# inventing an address. Accepts addresses or CIDR ranges, comma separated.
BUDGET_TRUSTED_PROXIES=

# Exchange rates (optional)
# Display-only currency conversion. Disabled by default: when off, the application makes no
# outbound requests and amounts render in their own currency. Enabling it lets the server
# fetch European Central Bank reference rates from Frankfurter and cache them in PostgreSQL.
BUDGET_EXCHANGE_RATES_ENABLED=false
BUDGET_EXCHANGE_RATES_BASE_URL=https://api.frankfurter.dev
BUDGET_EXCHANGE_RATES_TIMEOUT=10s

# Invitation email (optional)
# Disabled by default: when off, an invitation's one-time code is shown to the inviter to
# pass on directly, and the application makes no outbound SMTP connection.
#
# The connection is always encrypted. Port 465 uses TLS immediately, any other port
# negotiates STARTTLS, and a relay offering neither is refused rather than downgraded.
#
# Gmail: set BUDGET_SMTP_HOST=smtp.gmail.com and BUDGET_SMTP_PORT=587, set the username to
# the full Gmail address, and generate an App Password at
# https://myaccount.google.com/apppasswords for BUDGET_SMTP_PASSWORD. Gmail rejects the
# normal account password here, and an App Password requires 2-Step Verification to be on.
# Leave BUDGET_SMTP_FROM_ADDRESS empty to send as the authenticated account, which is what
# Gmail expects.
BUDGET_SMTP_ENABLED=false
BUDGET_SMTP_HOST=smtp.gmail.com
BUDGET_SMTP_PORT=587
BUDGET_SMTP_USERNAME=you@example.com
BUDGET_SMTP_PASSWORD=
BUDGET_SMTP_FROM_ADDRESS=
BUDGET_SMTP_FROM_NAME=Budget
BUDGET_SMTP_TIMEOUT=15s

# PostgreSQL
POSTGRES_DB=budget
POSTGRES_USER=budget
POSTGRES_PASSWORD=change-me
BUDGET_DATABASE_URL=postgres://budget:change-me@localhost:5432/budget?sslmode=disable
